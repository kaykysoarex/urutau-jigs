# Configure dois acessos distintos. Senhas de 12 caracteres ou mais, até 72 bytes.
ADMIN_1_USERNAME=administrador1
ADMIN_1_PASSWORD=
ADMIN_2_USERNAME=administrador2
ADMIN_2_PASSWORD=

# Validade da autenticação persistente em dias. Informe um inteiro positivo.
# REMEMBER_ME_DAYS=90

# Provedor padrão do gerador inteligente. Para o plano gratuito, use a chave
# de um projeto Free Tier no Google AI Studio.
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Opcionais. Usados somente com AI_PROVIDER=openai.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Opcionais para execução local. Por padrão, use o H2 persistente.
# PORT=8080
# SERVER_ADDRESS=127.0.0.1

# Descomente e configure para usar MySQL.
# DB_URL=jdbc:mysql://localhost:3306/urutau_jigs?connectionTimeZone=UTC
# DB_USER=urutau_app
# DB_PASSWORD=

# Ative em uma implantação HTTPS e configure os cabeçalhos de acordo com o proxy.
# SESSION_COOKIE_SECURE=true
# FORWARD_HEADERS_STRATEGY=framework
